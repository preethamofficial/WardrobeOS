DEBUG=True
SECRET_KEY=change-this-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946
DEFAULT_CITY=Bengaluru

# Optional: require login for every page (local-first default is open)
LOGIN_REQUIRED=False

# Console log level (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# Optional AI providers. Keep blank to skip a provider; the app still starts.
# NOTE: colour identification (naming, family, pattern) is fully OFFLINE and
# needs no keys at all. Providers only add extras: category / material /
# formality from photos, plus the text features in Prompt Lab.
# Free tiers exist today but terms change - check each provider's current policy.
AI_PROVIDER_ORDER=groq,gemini,openrouter,huggingface,local
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Prompt Lab: per-minute cap on AI endpoints (per browser session/IP)
AI_RATE_LIMIT_PER_MINUTE=12

# --- Multi-user / hosted deployment -----------------------------------------
# Set LOGIN_REQUIRED=True when you host this for multiple users so every
# visitor must sign in. Each signed-in user sees only their own wardrobe.
# LOGIN_REQUIRED=True

# Optional Google Sign-In - 100% free, no billing needed:
# 1. https://console.cloud.google.com -> create a free project
# 2. APIs & Services -> OAuth consent screen -> External -> add your email as test user
# 3. Credentials -> Create credentials -> OAuth client ID -> Web application
# 4. Authorised redirect URI: https://YOUR-DOMAIN/accounts/google/login/callback/
#    (and locally: http://127.0.0.1:8000/accounts/google/login/callback/)
# 5. Put the client id/secret here - the Google button appears automatically.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=



