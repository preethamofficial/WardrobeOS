# Local development defaults. Copy to `.env` and edit.
# Every name below also accepts a `DJANGO_`-prefixed form (e.g. DJANGO_SECRET_KEY),
# which is what Render and most Docker hosts inject by convention.
DEBUG=True

# REQUIRED IN PRODUCTION. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
# Startup fails with DEBUG=False if this is blank or still the placeholder below.
SECRET_KEY=change-this-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Fallback weather location. A signed-in user's saved city always wins over these.
DEFAULT_LATITUDE=12.9716
DEFAULT_LONGITUDE=77.5946
DEFAULT_CITY=Bengaluru

# Optional: require login for every page (local-first default is open)
LOGIN_REQUIRED=False

# Console log level (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# Optional AI providers. Keep blank to skip a provider; the app still starts.
# NOTE: colour identification (naming, family, pattern) is fully OFFLINE and
# needs no keys at all. Providers only add extras: category / material /
# formality from photos, plus the text features in Prompt Lab.
# Free tiers exist today but terms change - check each provider's current policy.
AI_PROVIDER_ORDER=ollama,groq,gemini,openrouter,huggingface,local

GROQ_API_KEY=
# openai/gpt-oss-20b is on Groq's free developer tier. The older
# llama-3.3-70b-versatile now requires an Enterprise plan.
GROQ_MODEL=openai/gpt-oss-20b

# Google retires Gemini model IDs often AND access-limits older generations
# (the whole 2.5 line is now restricted to projects that used it earlier), so a
# brand-new key cannot use 2.5 IDs. Keep the default, or pick from
# https://ai.google.dev/gemini-api/docs/models . If a model is ever retired the
# adapter automatically retries the next candidate, so this can stay as-is.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

OPENROUTER_API_KEY=
# OpenRouter drops `:free` variants without warning. List the live ones at
# https://openrouter.ai/api/v1/models and look for the ":free" suffix.
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional: fully local text AI through Ollama (https://ollama.com).
# No account, no key, no data leaves your machine - ideal for privacy-first use.
# NOTE: not usable on Render/Docker (no GPU/CPU budget for a local model);
# it is for running the app on your own Windows/Linux machine.
# Install Ollama, then `ollama pull llama3.2` and set OLLAMA_ENABLED=True.
OLLAMA_ENABLED=False
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Prompt Lab: per-minute cap on AI endpoints, applied per signed-in user
# (per IP for anonymous visitors) and shared across all worker processes.
AI_RATE_LIMIT_PER_MINUTE=12
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_ENABLED=True

# Upload limits for wardrobe photos (checked before anything is saved).
MAX_UPLOAD_IMAGE_MB=8
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_SIDE=8000
MIN_IMAGE_SIDE=64

# Email verification is optional by default so existing accounts can log in.
# Set to mandatory only after SMTP verification is confirmed working.
ACCOUNT_EMAIL_VERIFICATION=optional
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
# Example Gmail SMTP: EMAIL_HOST=smtp.gmail.com and use a Google App Password.
# Brevo/Resend/Mailgun SMTP credentials work as well.

# --- Multi-user / hosted deployment -----------------------------------------
# Set LOGIN_REQUIRED=True when you host this for multiple users so every
# visitor must sign in. Each signed-in user sees only their own wardrobe.
# LOGIN_REQUIRED=True

# HTTPS hardening. Implied by DEBUG=False, so production is covered without
# setting anything. Set it explicitly only if you need to force/stop redirects.
# Render and PythonAnywhere terminate TLS at their proxy, so leave it True there.
# FORCE_HTTPS=True

# Only enable behind a proxy you control (Render/PythonAnywhere/nginx). When on,
# X-Forwarded-For is trusted for rate limiting; the header is client-spoofable
# otherwise, which would let anyone bypass the AI rate limit.
# TRUST_PROXY_HEADERS=True

# HSTS: the seconds below apply once HTTPS is forced. Preload is deliberately
# NOT enabled - it is effectively irreversible for a domain, so opt in per site.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False

# Persistent storage. Render's free tier has an EPHEMERAL disk, so uploaded
# Render's web filesystem is ephemeral. For hosted multi-user deployments,
# use durable PostgreSQL plus S3-compatible object storage.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# USE_OBJECT_STORAGE=True
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=wardrobe-media
# AWS_S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# AWS_S3_REGION_NAME=<supabase-region>
# MEDIA_ROOT=/app/media

# Optional shared cache. Rate limiting is database-backed, so this is only for
# other caching, and needs `pip install redis` when set.
# REDIS_URL=redis://localhost:6379/0

# --- Deploy (Render) ---------------------------------------------------------
# These are already set by render.yaml. You only need them when deploying by
# hand (PythonAnywhere, Docker, your own server):
#   DEBUG=False
#   ALLOWED_HOSTS=your-domain.com
#   CSRF_TRUSTED_ORIGINS=https://your-domain.com
#   LOGIN_REQUIRED=True
#   FORCE_HTTPS=True

# Optional Google Sign-In - 100% free, no billing needed:
# 1. https://console.cloud.google.com -> create a free project
# 2. APIs & Services -> OAuth consent screen -> External -> add your email as test user
# 3. Credentials -> Create credentials -> OAuth client ID -> Web application
# 4. Authorised redirect URI: https://YOUR-DOMAIN/accounts/google/login/callback/
#    (and locally: http://127.0.0.1:8000/accounts/google/login/callback/)
# 5. Put the client id/secret here - the Google button appears automatically.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
